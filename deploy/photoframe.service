[Unit]
Description=Photoframe e-ink slideshow and companion app
Documentation=https://github.com/chinmay28/photoframe
# Start without waiting for the network: the frame must keep showing cached
# photos when Wi-Fi is down. Sources sync when the network comes back.
After=local-fs.target network.target
# If a source is a NAS share, add a drop-in with RequiresMountsFor=/mnt/photos
# (systemctl edit photoframe).

[Service]
Type=simple
User=photoframe
Group=photoframe
SupplementaryGroups=spi gpio
ExecStart=/usr/local/bin/photoframe -data /var/lib/photoframe -listen :80
# A Pi Zero 2 W has 512 MB. Decoding a large phone photo takes tens of
# megabytes at a time; this makes Go collect garbage harder well before the
# kernel would have to kill the service. It is a target, not a hard cap.
Environment=GOMEMLIMIT=256MiB
StateDirectory=photoframe
StateDirectoryMode=0750
# Everything outside the state directory is read-only to the service (see
# ProtectSystem below). /var/photoframe is the folder for photos you copy
# onto the Pi yourself; the service may write there too, so it can set their
# mode and owner at each sync. The "-" lets the service start when the folder
# doesn't exist. install.sh --photos-dir (PHOTOFRAME_PHOTOS_DIR for
# quickstart.sh) picks another folder and writes a drop-in for it.
ReadWritePaths=-/var/photoframe
# Listen on port 80 without running as root, and take ownership of photos
# that another user copied into a photo folder.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_CHOWN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN
# CAP_CHOWN reaches every file the service can write to, and /dev is one such
# place. So the only devices it may open are the panel's: SPI and GPIO (the
# names are those in /proc/devices), plus the harmless ones every service
# gets, such as /dev/null and /dev/urandom.
DevicePolicy=closed
DeviceAllow=char-spi rw
DeviceAllow=char-gpiochip rw
Restart=always
RestartSec=5
# The panel refresh can take ~40 s; let it finish and power down cleanly.
TimeoutStopSec=60

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
