<?xml version="1.0" encoding="utf-8"?>
<!-- Every row: titles wrap rather than being cut off, and no gutter is kept
     for icons that none of them has. -->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_frame">
        <EditTextPreference
            app:iconSpaceReserved="false"
            app:key="frame_address"
            app:singleLineTitle="false"
            app:title="@string/pref_address"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="find_frames"
            app:singleLineTitle="false"
            app:summary="@string/pref_find_summary"
            app:title="@string/pref_find" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_cat_about">
        <Preference
            app:iconSpaceReserved="false"
            app:key="thin"
            app:selectable="false"
            app:singleLineTitle="false"
            app:summary="@string/pref_thin_summary"
            app:title="@string/pref_thin" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="version"
            app:singleLineTitle="false"
            app:title="@string/pref_version" />
        <Preference
            app:icon="@drawable/dev_badge_round"
            app:key="developer"
            app:singleLineTitle="false"
            app:summary="@string/pref_developer_summary"
            app:title="@string/pref_developer" />
    </PreferenceCategory>
</PreferenceScreen>
